<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fica fora de api/, entao nao herda o Directory.Build.props de la: as propriedades vem aqui. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\api\Ampara.Api\Ampara.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <!-- Alinha com a versao que o Ampara.Api usa: sem isto o MSBuild escolhe a 10.0.4 trazida pelo Npgsql (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rastro sincrono, log capturado e helpers de cenario: uma so copia, a da suite da API. -->
    <Compile Include="..\..\api\Ampara.Tests\Cyber\CyberApiFactory.cs" Link="Compartilhado\CyberApiFactory.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Os mesmos arquivos de apoio da suite da API: delegacias e risco de teste. -->
    <None Include="..\..\api\Ampara.Tests\Fixtures\delegacias-teste.json" Link="Fixtures\delegacias-teste.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\api\Ampara.Tests\Fixtures\risco-teste.csv" Link="Fixtures\risco-teste.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
