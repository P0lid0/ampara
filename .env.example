# Ampara - variaveis de ambiente (copie para .env; nunca commite o .env)
# Segredos ficam vazios aqui e so existem em variavel de ambiente.

# API Ampara: conexao com o PostgreSQL (preencha a senha so no seu .env)
AMPARA_DB=Host=localhost;Port=5432;Database=ampara;Username=ampara;Password=
# API Ampara: segredo de assinatura do JWT (64+ caracteres aleatorios)
AMPARA_JWT_SECRET=
# API Ampara: chave AES-GCM para IMEI e contas = 32 bytes em base64
AMPARA_CRYPTO_KEY=
# API Ampara: true habilita /seguranca/simular-ataque e o taint desligado; false em producao
AMPARA_DEMO=true
# API Ampara: caminho da tabela de risco gerada pelo ML
RISCO_CSV=ml/saida/risco.csv
# API Ampara: broker MQTT que recebe o chaveiro
MQTT_HOST=broker.hivemq.com
# API Ampara: porta do broker MQTT
MQTT_PORT=1883
# API Ampara: endereco da Ponte Policia
PONTE_URL=http://127.0.0.1:8000
# API Ampara e Ponte: segredo compartilhado (cabecalho de servico)
PONTE_CHAVE_SERVICO=
# Ponte (painel da policia): chave do cabecalho X-Chave-Policia
PONTE_CHAVE_POLICIA=
# Ponte Policia: conexao com o PostgreSQL da ponte (senha so no seu .env)
PONTE_DB=postgresql+psycopg://ponte:@localhost:5432/ponte
# API Ampara: chave da Claude API (traducao do Painel Risco Cidadao)
ANTHROPIC_API_KEY=
# API Ampara: modelo usado pelo painel
ANTHROPIC_MODEL=claude-haiku-5-5
# App e paginas web: URL da API (emulador Android: 10.0.2.2; na demo, URL do tunel)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080
