[Unit]
Description=Ampara - API (ASP.NET)
Documentation=file:///opt/ampara/src/infra/README.md
After=ampara-migrations.service
Requires=ampara-migrations.service

[Service]
Type=simple
User=ampara
Group=ampara
WorkingDirectory=/opt/ampara/api
EnvironmentFile=/etc/ampara/ampara.env
EnvironmentFile=-/etc/ampara/segredos.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_ROOT=/usr/share/dotnet
Environment=DOTNET_NOLOGO=1
ExecStart=/usr/local/bin/dotnet /opt/ampara/api/Ampara.Api.dll
# RestartSec maior que o INTERVALO_S do monitor, de proposito: o monitor precisa enxergar a queda.
Restart=always
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
