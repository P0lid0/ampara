{"openapi":"3.1.0","info":{"title":"Ponte Polícia — Ampara","description":"Recebe ocorrências sem dado pessoal da API da Ampara e devolve o retorno da polícia.","version":"1.0.0"},"paths":{"/health":{"get":{"tags":["saude"],"summary":"Verifica se a Ponte está no ar","description":"Não exige chave e não consulta o banco; serve ao healthcheck do nginx/compose.","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":{"type":"string"},"type":"object","title":"Response Health Health Get"}}}}}}},"/ocorrencias":{"post":{"tags":["ocorrencias"],"summary":"Registra uma ocorrência (idempotente por origem_id)","description":"Recebe a ocorrência enviada pela API da Ampara. Reenviar o mesmo origem_id devolve 200 com o protocolo já existente. Payload com dado pessoal é rejeitado com 422.","operationId":"criar_ocorrencia_ocorrencias_post","security":[{"ChaveServico":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OcorrenciaCriar"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProtocoloResposta"}}}},"200":{"description":"origem_id já registrado: devolve o protocolo existente.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProtocoloResposta"}}}},"401":{"description":"Chave de serviço inválida ou ausente.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroSimples"}}}},"422":{"description":"Payload inválido (ErroValidacao), com dado pessoal (ErroPii) ou corpo que não é JSON (ErroSimples).","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/ErroValidacao"},{"$ref":"#/components/schemas/ErroPii"},{"$ref":"#/components/schemas/ErroSimples"}],"title":"Response 422 Criar Ocorrencia Ocorrencias Post"}}}}}},"get":{"tags":["ocorrencias"],"summary":"Lista ocorrências para o painel da polícia","description":"Mais recentes primeiro; filtro opcional por status. Não expõe device_hash nem trilha.","operationId":"listar_ocorrencias_ocorrencias_get","security":[{"ChavePolicia":[]}],"parameters":[{"name":"status","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/StatusOcorrencia"},{"type":"null"}],"title":"Status"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OcorrenciaResumo"},"title":"Response Listar Ocorrencias Ocorrencias Get"}}}},"401":{"description":"Chave da polícia inválida ou ausente.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroSimples"}}}},"422":{"description":"Status desconhecido.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroValidacao"}}}}}}},"/ocorrencias/{protocolo}/retorno":{"get":{"tags":["ocorrencias"],"summary":"Retorno atual ao cidadão","description":"Devolve o status e a mensagem mais recentes da ocorrência, para a API da Ampara repassar ao cidadão pelo protocolo.","operationId":"obter_retorno_ocorrencias__protocolo__retorno_get","security":[{"ChaveServico":[]}],"parameters":[{"name":"protocolo","in":"path","required":true,"schema":{"type":"string","title":"Protocolo"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RetornoResposta"}}}},"401":{"description":"Chave de serviço inválida ou ausente.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroSimples"}}}},"404":{"description":"Protocolo não encontrado.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroSimples"}}}},"422":{"description":"Parâmetro inválido.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErroValidacao"}}}}}}},"/ocorrencias/{protocolo}/status":{"patch":{"tags":["ocorrencias"],"summary":"Muda o status e registra a mensagem de